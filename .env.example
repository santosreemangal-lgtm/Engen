# Optional dashboard and Telegram paper-bot settings.
# Keep real bot tokens in your private Codespaces/terminal environment, not in Git.
DASHBOARD_HOST=127.0.0.1
TELEGRAM_BOT_TOKEN=
# Add your own numeric Telegram chat ID; do not leave this blank when running the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
ENGINE_MODE=read_only
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false
