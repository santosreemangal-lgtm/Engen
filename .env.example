# Optional dashboard and Telegram paper-bot settings.
# Keep real bot tokens in your private Codespaces/terminal environment, not in Git.
DASHBOARD_HOST=127.0.0.1
TELEGRAM_BOT_TOKEN=
# Add your own numeric Telegram chat ID; do not leave this blank when running the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
ENGINE_MODE=read_only
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false
# Rust paper-execution fee model (all network values are USD estimates per fill).
ENGEN_PAPER_TRADING_FEE_BPS=10
ENGEN_PAPER_NETWORK_FEE_USD=0
ENGEN_PAPER_PRIORITY_FEE_USD=0
