# Example values only. This file contains no credentials and is not loaded automatically.
# Copy values into your Codespaces/environment settings as needed. Never commit a real .env.

# Engine safety defaults
ENGINE_MODE=read_only
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false

# Keep the private dashboard bound to this machine by default.
DASHBOARD_HOST=127.0.0.1
# Optional: set a randomly generated token of at least 32 characters in your environment.
# Do not use a shared token as multi-user/per-profile authorization.
# DASHBOARD_AUTH_TOKEN=

# Public RPC transport policy (read-only; remote endpoints must use HTTPS).
ENGEN_RPC_URL=https://api.mainnet-beta.solana.com
ENGEN_RPC_RETRIES=2
ENGEN_RPC_BACKOFF_SECONDS=0.5
ENGEN_RPC_MIN_INTERVAL_SECONDS=0.1

# Optional SQLite database paths (defaults are used when these are unset).
# PROFILE_STORE_DB=data/profiles.db
# PAPER_SIMULATOR_DB=data/paper_simulator.db

# Read-only dashboard monitor performance controls.
# Up to this many wallet scans run concurrently (bounded by saved wallet count).
MONITOR_SCAN_WORKERS=4
# Upper bound for an individual public RPC request; default 10 seconds.
MONITOR_RPC_TIMEOUT_SECONDS=10
