# Paper only. Do not set ENGEN_LIVE_ENABLED.
ENGEN_BIND=127.0.0.1:8787
ENGEN_PAPER_DB=/opt/engen/data/paper_simulator.db
ENGEN_PROFILE_DB=/opt/engen/data/profiles.db
ENGEN_POLL_SECONDS=15
# Optional public-wallet list. Never put a private key here.
ENGEN_WALLETS=
SOLANA_RPC_URL=
# Required only when ENGEN_BIND is not localhost.
# DASHBOARD_TRUST_PROXY=true
# DASHBOARD_AUTH_TOKEN=replace-with-32-or-more-random-characters
